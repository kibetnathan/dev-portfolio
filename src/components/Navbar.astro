---
---
<!-- Navbar -->
<div class="fixed top-0 z-50 flex justify-center w-full">
  <nav aria-label="Primary" class="w-[92%] max-w-7xl bg-dark/80 backdrop-blur-xl rounded-b-3xl px-4 sm:px-6 md:px-8 py-3 md:py-3.5 flex items-center justify-between border border-light/[0.08] border-t-0 shadow-2xl shadow-black/40">
    <!-- Logo -->
    <a href="/" aria-label="Kigen — home" class="signature font-signature text-3xl sm:text-4xl text-primary leading-none select-none hover:scale-105 transition-transform">
      Kigen
    </a>

    <!-- Desktop Nav Pills -->
    <ul class="hidden lg:flex gap-1.5 text-sm" role="menubar">
      <li role="none">
        <a role="menuitem" href="/" class="px-5 py-2 rounded-xl font-medium inline-block text-light/50 hover:text-light hover:bg-light/5 transition-all">Home</a>
      </li>
      <li role="none">
        <a role="menuitem" href="/#about" class="px-5 py-2 rounded-xl font-medium inline-block text-light/50 hover:text-light hover:bg-light/5 transition-all">About</a>
      </li>
      <li role="none">
        <a role="menuitem" href="/blog" class="px-5 py-2 rounded-xl font-medium inline-block text-light/50 hover:text-light hover:bg-light/5 transition-all">Blog</a>
      </li>
      <li role="none">
        <button role="menuitem" data-copy-email aria-label="Copy email address to clipboard" class="px-5 py-2 rounded-xl font-medium inline-block text-light/50 hover:text-light hover:bg-light/5 transition-all cursor-pointer">Contact</button>
      </li>
    </ul>

    <!-- Right side controls -->
    <div class="flex items-center gap-2 sm:gap-3">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark/light mode"
        aria-pressed="false"
        class="w-9 h-9 flex items-center justify-center rounded-xl border border-light/10 text-light/50 hover:text-light hover:border-light/30 hover:bg-light/5 transition-all"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <a
        href="/Nathan_Kibet_CV.pdf"
        download
        aria-label="Download CV as PDF"
        class="hidden sm:inline-flex bg-primary text-dark text-xs md:text-sm font-bold px-4 md:px-6 py-2.5 rounded-xl hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/30 transition-all hover:-translate-y-0.5 whitespace-nowrap"
      >
        <span class="hidden md:inline">Download CV ↓</span>
        <span class="md:hidden">CV ↓</span>
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden w-9 h-9 flex items-center justify-center rounded-xl border border-light/10 text-light/70 hover:text-light hover:border-light/30 hover:bg-light/5 transition-all"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-burger" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="6" y1="18" x2="18" y2="6" />
        </svg>
      </button>
    </div>
  </nav>
</div>

<!-- Mobile menu panel -->
<div
  id="mobile-menu"
  class="fixed inset-0 top-0 z-40 bg-dark/95 backdrop-blur-xl flex-col items-center justify-center gap-6 px-8 hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
>
  <ul class="flex flex-col items-center gap-3 text-xl font-display uppercase tracking-wider w-full max-w-xs">
    <li class="w-full">
      <a href="/" class="mobile-link block w-full text-center px-6 py-4 rounded-2xl border border-light/10 text-light hover:border-primary/50 hover:text-primary transition-all">Home</a>
    </li>
    <li class="w-full">
      <a href="/#about" class="mobile-link block w-full text-center px-6 py-4 rounded-2xl border border-light/10 text-light hover:border-primary/50 hover:text-primary transition-all">About</a>
    </li>
    <li class="w-full">
      <a href="/blog" class="mobile-link block w-full text-center px-6 py-4 rounded-2xl border border-light/10 text-light hover:border-primary/50 hover:text-primary transition-all">Blog</a>
    </li>
    <li class="w-full">
      <button data-copy-email type="button" aria-label="Copy email address to clipboard" class="mobile-link block w-full text-center px-6 py-4 rounded-2xl border border-light/10 text-light hover:border-primary/50 hover:text-primary transition-all font-display uppercase tracking-wider cursor-pointer">Contact</button>
    </li>
    <li class="w-full pt-2">
      <a href="/Nathan_Kibet_CV.pdf" download class="mobile-link block w-full text-center px-6 py-4 rounded-2xl bg-primary text-dark font-black transition-all">Download CV ↓</a>
    </li>
  </ul>
</div>

<style>
  #mobile-menu.is-open {
    display: flex;
  }
  body.menu-open {
    overflow: hidden;
  }
</style>

<script>
  const html = document.documentElement;
  const btn = document.getElementById('theme-toggle')!;
  const sun = document.getElementById('icon-sun')!;
  const moon = document.getElementById('icon-moon')!;

  function applyTheme(isLight: boolean) {
    html.classList.toggle('light', isLight);
    sun.classList.toggle('hidden', isLight);
    moon.classList.toggle('hidden', !isLight);
    btn.setAttribute('aria-pressed', String(isLight));
  }

  applyTheme(html.classList.contains('light'));

  btn.addEventListener('click', () => {
    html.classList.add('theme-transition');
    const isLight = !html.classList.contains('light');
    applyTheme(isLight);
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    setTimeout(() => html.classList.remove('theme-transition'), 200);
  });

  // Mobile menu
  const menuToggle = document.getElementById('mobile-menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const burger = document.getElementById('icon-burger')!;
  const close = document.getElementById('icon-close')!;

  function setMenu(open: boolean) {
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    burger.classList.toggle('hidden', open);
    close.classList.toggle('hidden', !open);
    document.body.classList.toggle('menu-open', open);
  }

  menuToggle.addEventListener('click', () => {
    const isOpen = menu.classList.contains('is-open');
    setMenu(!isOpen);
  });

  // Close menu when clicking a link inside
  menu.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.classList.contains('is-open')) {
      setMenu(false);
      menuToggle.focus();
    }
  });

  // Close if viewport grows past lg breakpoint
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && menu.classList.contains('is-open')) {
      setMenu(false);
    }
  });
</script>
