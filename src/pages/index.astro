---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.jsx";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import BlogSnippet from "../components/BlogSnippet.astro";
---

<BaseLayout>
  <Hero client:load />
  <About />
  <Projects />
  <BlogSnippet />

  <div class="scroll-progress"></div>
</BaseLayout>

<script>
  const sections = document.querySelectorAll("[data-scroll-section]");
  const progressBar = document.querySelector(".scroll-progress") as HTMLElement;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function onScroll() {
    // Progress bar
    const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
    const progress = scrollTop / (scrollHeight - clientHeight);
    if (progressBar) {
      progressBar.style.transform = `scaleX(${progress})`;
    }

    if (prefersReducedMotion) return;

    // Per-heading parallax
    const vh = window.innerHeight;
    document.querySelectorAll("[data-parallax]").forEach((heading) => {
      const el = heading as HTMLElement;
      const rect = el.getBoundingClientRect();
      const progress = 1 - (rect.top + vh) / (vh + rect.offsetHeight);
      const clamped = Math.max(0, Math.min(1, progress));
      const y = -200 + clamped * 400;
      el.style.transform = `translateY(${y}px)`;
      el.style.willChange = "transform";
    });
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style is:global>
  /* Scroll-snap only on taller/wider viewports — on mobile it fights touch scroll */
  @media (min-width: 1024px) and (min-height: 700px) {
    html {
      scroll-snap-type: y proximity;
    }
    [data-scroll-section] {
      min-height: 100vh;
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-snap-type: none !important; }
    [data-parallax] { transform: none !important; }
  }

  .scroll-progress {
    position: fixed;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-primary);
    bottom: 0;
    transform-origin: left;
    transform: scaleX(0);
    z-index: 100;
    pointer-events: none;
  }
</style>
