---
import BaseLayout from "../layouts/BaseLayout.astro";

const modules = import.meta.glob('../blogs/*.md', { eager: true });
const sorted = Object.entries(modules)
  .map(([path, mod]: [string, any]) => ({
    slug: path.split('/').pop()!.replace('.md', ''),
    ...mod.frontmatter,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<BaseLayout title="Blog | Kigen Dev">
  <!-- Hero -->
  <section class="relative min-h-[60vh] flex flex-col items-center justify-center text-center px-6 pt-32 pb-20 overflow-hidden bg-[var(--color-dark)] transition-colors">
    <div
      class="absolute inset-0 opacity-[0.12]"
      style="background-image: radial-gradient(circle, var(--color-light) 1px, transparent 1px); background-size: 28px 28px;"
    ></div>

    <div class="relative z-10">
      <p class="text-[var(--color-primary)] font-semibold tracking-widest uppercase text-sm mb-4">
        Writing
      </p>
      <h1 class="font-[var(--font-display)] text-6xl md:text-8xl leading-none text-[var(--color-light)] mb-6">
        Latest posts<br />from Kigen
      </h1>
      <p class="font-[var(--font-body)] text-[var(--color-secondary)] text-xl max-w-md mb-10">
        Thoughts on web development, design, and the things I'm building. You can also read them on dev.to.
      </p>
      <a
        href="https://dev.to/kigen"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-[var(--color-light)]/15 text-[var(--color-light)] hover:text-[var(--color-primary)] hover:border-[var(--color-primary)]/40 font-medium px-6 py-3 rounded-xl transition-all hover:bg-[var(--color-light)]/5"
      >
        Read on dev.to
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Posts -->
  <section class="bg-[var(--color-dark)] transition-colors border-t border-[var(--color-light)]/[0.08]">
    <div class="max-w-4xl mx-auto px-6 py-20 space-y-6">
      {sorted.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group block border border-[var(--color-light)]/[0.08] rounded-2xl p-8 hover:border-[var(--color-primary)]/30 hover:bg-[var(--color-light)]/[0.02] transition-all"
        >
          <div class="flex items-start justify-between gap-6">
            <div class="space-y-3 flex-1">
              <div class="flex items-center gap-3 flex-wrap">
                {post.tags?.map((tag: string) => (
                  <span class="text-[0.6rem] font-black uppercase tracking-widest text-[var(--color-secondary)] border border-[var(--color-secondary)]/30 px-2.5 py-1 rounded-lg">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="font-[var(--font-display)] text-3xl text-[var(--color-light)] group-hover:text-[var(--color-primary)] transition-colors leading-tight">
                {post.title}
              </h2>
              <p class="text-[var(--color-secondary)] text-base leading-relaxed">
                {post.description}
              </p>
            </div>
            <span class="shrink-0 mt-1 text-[var(--color-primary)] opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-xl">→</span>
          </div>
          <p class="mt-5 text-[var(--color-secondary)] text-xs font-mono uppercase tracking-widest">
            {new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
